{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "./gradlew :server:installDist"
  },
  "deploy": {
    "startCommand": "./server/build/install/server/bin/server",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/",
    "numReplicas": 1
  }
}
